{
  "name": "@tonycdr-prog/architect-mcp",
  "version": "0.2.1",
  "description": "A local-first agent work gate for coding agents.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonycdr-prog/architect-mcp.git"
  },
  "main": "./dist/library.js",
  "types": "./dist/library.d.ts",
  "exports": {
    ".": {
      "types": "./dist/library.d.ts",
      "import": "./dist/library.js"
    },
    "./server": {
      "types": "./dist/server/createArchitectServer.d.ts",
      "import": "./dist/server/createArchitectServer.js"
    }
  },
  "bin": {
    "architect-mcp": "./dist/index.js",
    "architect-mcp-http": "./dist/http.js",
    "architect-mcp-tui": "./bin/architect-mcp-tui.cjs"
  },
  "files": [
    "dist",
    "bin/architect-mcp-tui.cjs",
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml",
    "crates/architect-tui",
    "!crates/architect-tui/.architect-mcp",
    "!crates/architect-tui/.architect-mcp/**",
    "scripts/secretScan.mjs",
    "packs",
    "policy-bundles",
    "foundation-packs",
    "mcp-catalog",
    "stack-sources/llms-sources.json",
    "stack-sources/nextjs.md",
    "stack-sources/react-vite.md",
    "stack-sources/ingested/index.json",
    "examples",
    "docs/**/*.md",
    "llms.txt",
    "LICENSE",
    "SECURITY.md",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    ".env.example",
    "package.json"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "audit": "npm audit",
    "docs:get": "vitepress dev docs --host 0.0.0.0",
    "docs:tool-reference": "tsx scripts/generateToolReference.ts",
    "docs:tool-reference:check": "tsx scripts/generateToolReference.ts --check",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 0.0.0.0",
    "tui:build": "cargo build --workspace --release",
    "tui:test": "cargo test --workspace",
    "tui:live-qa": "cargo build --workspace --bin architect-mcp-tui && node bin/architect-mcp-tui.cjs --help && cargo test --workspace --test workflows",
    "rust:check": "cargo fmt --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "pack:dry-run": "npm pack --dry-run --json",
    "precheck:v3": "npm run build",
    "check:v3": "node dist/scripts/checkV3Readiness.js",
    "precheck:v5": "npm run build",
    "check:v5": "node dist/scripts/checkStagedReadiness.js v5",
    "precheck:v6": "npm run build",
    "check:v6": "node dist/scripts/checkStagedReadiness.js v6",
    "precheck:v7": "npm run build",
    "check:v7": "node dist/scripts/checkStagedReadiness.js v7",
    "precheck:v8": "npm run build",
    "check:v8": "node dist/scripts/checkStagedReadiness.js v8",
    "precheck:v9": "npm run build",
    "check:v9": "node dist/scripts/checkStagedReadiness.js v9",
    "precheck:v10": "npm run build",
    "check:v10": "node dist/scripts/checkStagedReadiness.js v10",
    "release:check": "npm run rust:check && npm run check:v10",
    "secret:scan": "node scripts/secretScan.mjs",
    "ingest:llms": "tsx scripts/ingestLlmsSources.ts",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "start:http": "node dist/http.js",
    "prepack": "node scripts/preparePackageManifest.cjs",
    "postpack": "node scripts/restorePackageManifest.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.8.0",
    "tsx": "^4.22.0",
    "vitepress": "^1.6.4"
  },
  "overrides": {
    "fast-uri": "3.1.2",
    "hono": "4.12.18",
    "ip-address": "^10.2.0",
    "vitepress": {
      "vite": "6.4.2"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}

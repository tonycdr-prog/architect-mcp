{
  "name": "architect-mcp",
  "version": "0.1.0",
  "description": "A local-first MCP standards and verification harness for coding agents.",
  "type": "module",
  "bin": {
    "architect-mcp": "./dist/index.js",
    "architect-mcp-http": "./dist/http.js"
  },
  "files": [
    "dist",
    "packs",
    "policy-bundles",
    "foundation-packs",
    "stack-sources",
    "examples",
    "docs",
    "llms.txt",
    "LICENSE",
    "SECURITY.md",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "audit": "npm audit",
    "pack:dry-run": "npm pack --dry-run --json",
    "check:v3": "tsx scripts/checkV3Readiness.ts",
    "check:v5": "tsx scripts/checkStagedReadiness.ts v5",
    "check:v6": "tsx scripts/checkStagedReadiness.ts v6",
    "check:v7": "tsx scripts/checkStagedReadiness.ts v7",
    "check:v8": "tsx scripts/checkStagedReadiness.ts v8",
    "check:v9": "tsx scripts/checkStagedReadiness.ts v9",
    "check:v10": "tsx scripts/checkStagedReadiness.ts v10",
    "release:check": "npm run check:v10",
    "ingest:llms": "tsx scripts/ingestLlmsSources.ts",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "start:http": "node dist/http.js",
    "prepack": "node scripts/preparePackageManifest.cjs",
    "postpack": "node scripts/restorePackageManifest.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.1",
    "tsx": "^4.20.6"
  },
  "overrides": {
    "ip-address": "^10.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
